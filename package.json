{
    "name": "rtl-markdown-cjk",
    "displayName": "RTL Markdown CJK",
    "description": "Markdown Right-to-Left support (with CJK)",
    "version": "1.0.0",
    "publisher": "your-name",
    "icon": "icon.png",
    "engines": {
        "vscode": "^1.80.0"
    },
    "categories": [
        "Formatters",
        "Other"
    ],
    "keywords": [
        "markdown",
        "rtl",
        "cjk"
    ],
    "activationEvents": [
        "onLanguage:markdown",
        "onCommand:rtl-markdown.active",
        "onCommand:rtl-markdown.deactive"
    ],
    "main": "./script/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "rtl-markdown.active",
                "title": "Active RTL-Markdown (CJK)"
            },
            {
                "command": "rtl-markdown.deactive",
                "title": "Deactive RTL-Markdown (CJK)"
            },
            {
                "command": "rtl-markdown.rtl",
                "title": "RTL Markdown",
                "icon": "$(debug-step-over)"
            },
            {
                "command": "rtl-markdown.ltr",
                "title": "LTR Markdown",
                "icon": "$(debug-step-back)"
            }
        ],
        "menus": {
            "editor/title": [
                {
                    "when": "resourceLangId == markdown && resourceFilename =~ /^(?:.*(\\.rtl\\.md)).*$/",
                    "command": "rtl-markdown.ltr",
                    "group": "1_run"
                },
                {
                    "when": "resourceLangId == markdown && resourceFilename =~ /^(?!.*(\\.rtl\\.md)).*$/",
                    "command": "rtl-markdown.rtl",
                    "group": "1_run"
                }
            ]
        },
        "markdown.previewStyles": [
            "./style/preview.css",
            "./style/github.css"
        ],
        "markdown.previewScripts": [
            "./script/preview.js"
        ]
    },
    "dependencies": {
        "sudo-prompt": "^9.2.1"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/Earthly-j/rtl-markdown-CJK.git"
    }
}
